# Runtime state (generated locally, never committed)
persistence/
legacy/
.env
# Skills distilled by the learning loop (BAIZE_USER_SKILLS_DIR). Written at
# runtime by every successful `baize run`, so without this line each run left an
# untracked directory in `git status`.
user_skills/
__pycache__/
.pytest_cache/
*.pyc
.coverage
htmlcov/
.coverage.*

# OS / editor junk
.DS_Store
Thumbs.db
*.swp

# Python packaging artifacts
build/
dist/
*.egg-info/

# Example business projects (Agent-generated demos, not part of the engine).
# Kept on local disk for reference; the *content* is excluded to stay lean.
# The directory itself must exist: baize/doctor.py requires it (required=True)
# and nothing creates it, so ignoring the whole dir made every fresh clone end
# in "RESULT: FAILED" - the documented 1-minute quickstart could not pass.
projects/*
!projects/.gitkeep

# WorkBuddy project data (tool internals, not part of the deliverable)
.workbuddy/

# Local debug/probe scratch - one-off scripts and their logs.
# They hardcode machine-specific checkout paths and are worthless to
# anyone else; they must never be committed again.
examples/_probe*
examples/_diag*
*.log

# Coverage artefacts (regenerated by make cov).
coverage.xml
