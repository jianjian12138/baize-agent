# Baize Engine V25.0.0 - environment configuration
# Copy this file to .env and adjust paths for your machine.
# All BAIZE_* paths default to directories inside this repo if unset.

# ---------------------------------------------------------------
# Core directories (defaults are relative to repo root; override
# only if you relocate them)
# ---------------------------------------------------------------
# BAIZE_PERSISTENCE_DIR=./persistence
# BAIZE_PROJECTS_DIR=./projects
# BAIZE_ASSETS_DIR=./assets
# BAIZE_INDEX_FILE=./persistence/skill_index.json

# ---------------------------------------------------------------
# External skill libraries (comma separated absolute paths).
# The indexer scans these for SKILL.md files. Missing paths make
# `python -m baize doctor` fail so broken links are caught early.
# ---------------------------------------------------------------
# Defaults to the skills bundled in this repo so a fresh clone passes
# `baize doctor` with zero edits. Point this at your own skill libraries
# (comma separated absolute paths) if you keep them elsewhere.
SKILL_LIBRARY_PATHS=./assets/skills,./picasso-dev-skill,./skills

# ---------------------------------------------------------------
# Agent runtime (V19) - model endpoint
# Any OpenAI-compatible chat-completions endpoint works:
# OpenAI / OpenRouter / Ollama / vLLM / local gateways ...
# `baize run` and `baize team` refuse to start (exit 2) if unset.
# ---------------------------------------------------------------
# BAIZE_MODEL_BASE_URL=https://api.openai.com/v1
# BAIZE_MODEL_NAME=gpt-4o-mini
# BAIZE_LLM_MAX_RETRIES=2

# ---------------------------------------------------------------
# Agent runtime (V19) - loop & sandbox
# ---------------------------------------------------------------
# Hard cap on think->tool->observe iterations per agent run.
# BAIZE_AGENT_MAX_STEPS=24
# Tool sandbox root: file tools cannot escape this directory.
# BAIZE_WORKSPACE_DIR=./
# Set to 1 ONLY if you understand the risk of letting tools
# touch paths outside the workspace.
# BAIZE_ALLOW_OUTSIDE_WORKSPACE=0
# JSONL session transcripts (crash-safe, resumable via --resume).
# BAIZE_SESSIONS_DIR=./persistence/sessions

# ---------------------------------------------------------------
# Quality gate
# ---------------------------------------------------------------
TEST_COVERAGE_THRESHOLD=85
BAIZE_QUALITY_THRESHOLD=0.8

# ---------------------------------------------------------------
# Example project: simple-shopping-platform server
# ---------------------------------------------------------------
# API_KEY for write-endpoint auth (POST/PUT/DELETE). Fail-closed if unset.
# API_KEY=change_me_to_a_random_string
# CORS whitelist (comma separated). Defaults to localhost:5173,5174 if unset.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------------------------------------------------------------
# Secrets - NEVER commit real values. Keep them only in .env
# (which must be gitignored).
# ---------------------------------------------------------------
# BAIZE_MODEL_API_KEY=your_api_key_here
