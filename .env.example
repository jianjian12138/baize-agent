# Baize Engine V38.0.0 - environment configuration
# Copy this file to .env and adjust paths for your machine.
# All BAIZE_* paths default to directories inside this repo if unset.

# ---------------------------------------------------------------
# Core directories (defaults are relative to repo root; override
# only if you relocate them)
# ---------------------------------------------------------------
# BAIZE_PERSISTENCE_DIR=./persistence
# BAIZE_PROJECTS_DIR=./projects
# BAIZE_ASSETS_DIR=./assets
# BAIZE_INDEX_FILE=./persistence/skill_index.json

# ---------------------------------------------------------------
# External skill libraries (comma separated absolute paths).
# The indexer scans these for SKILL.md files. Missing paths make
# `python -m baize doctor` FAIL so broken links are caught early -
# which is why every path listed here must actually exist.
# ---------------------------------------------------------------
# Defaults to the skills bundled in this repo so a fresh clone passes
# `baize doctor` with zero edits. Point this at your own skill libraries
# (comma separated absolute paths) if you keep them elsewhere.
# (This line used to list ./picasso-dev-skill and ./skills, neither of which
#  exists in this repo - copying this file made doctor fail with 2 extra
#  "skill library ... not found" errors.)
SKILL_LIBRARY_PATHS=./assets/skills

# ---------------------------------------------------------------
# Agent runtime (V19) - model endpoint
# Any OpenAI-compatible chat-completions endpoint works:
# OpenAI / OpenRouter / Ollama / vLLM / local gateways ...
# `baize run` and `baize team` refuse to start (exit 2) if unset.
# ---------------------------------------------------------------
# BAIZE_MODEL_BASE_URL=https://api.openai.com/v1
# BAIZE_MODEL_NAME=gpt-4o-mini
# BAIZE_LLM_MAX_RETRIES=2

# ---------------------------------------------------------------
# Agent runtime (V19) - loop & sandbox
# ---------------------------------------------------------------
# Hard cap on think->tool->observe iterations per agent run.
# BAIZE_AGENT_MAX_STEPS=24
# Tool sandbox root: file tools cannot escape this directory.
# BAIZE_WORKSPACE_DIR=./
# Set to 1 ONLY if you understand the risk of letting tools
# touch paths outside the workspace.
# BAIZE_ALLOW_OUTSIDE_WORKSPACE=0
# JSONL session transcripts (crash-safe, resumable via --resume).
# BAIZE_SESSIONS_DIR=./persistence/sessions

# ---------------------------------------------------------------
# Quality gate
# ---------------------------------------------------------------
# Coverage floor enforced by scripts/coverage_gate.py and CI. This is the
# project's own contract (pinned by tests/test_config.py). Run `make cov` for the
# current measured value - it is deliberately not written here: this line used to
# read "Measured coverage on 2026-09-17 was 77.4%, so the gate fails", and it kept
# reading that after the gate had gone green. Raise coverage, do not lower this.
TEST_COVERAGE_THRESHOLD=85
BAIZE_QUALITY_THRESHOLD=0.8

# ---------------------------------------------------------------
# Service auth (`baize serve`) - FAIL-CLOSED
# ---------------------------------------------------------------
# BAIZE_AUTH_TOKEN is REQUIRED for any write operation (POST/PUT/DELETE).
# If it is unset, the server returns 401 for every write instead of silently
# trusting the caller. Read-only routes (/health, /metrics, /) stay open.
#
# Generate one, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(32))"
# BAIZE_AUTH_TOKEN=
#
# Escape hatch for a single user on localhost ONLY. Setting this to 1 makes the
# server accept unauthenticated writes again. Never set it on a shared or
# network-reachable host - it re-opens remote code execution via the /v30 routes.
# BAIZE_ALLOW_NO_AUTH=0
#
# Cross-origin allowlist (comma separated). Empty = no CORS header is sent, so
# browsers enforce same-origin. Set this only for a dashboard you host elsewhere.
# BAIZE_CORS_ORIGINS=
#
# POST /v30/synthesize and POST /v30/adversarial execute the code you send them.
# They are OFF unless BOTH a real BAIZE_AUTH_TOKEN is configured AND this is 1.
# BAIZE_ENABLE_SYNTHESIS_API=0

# ---------------------------------------------------------------
# Example project: simple-shopping-platform server
# ---------------------------------------------------------------
# API_KEY for write-endpoint auth (POST/PUT/DELETE). Fail-closed if unset.
# API_KEY=change_me_to_a_random_string
# CORS whitelist (comma separated). Defaults to localhost:5173,5174 if unset.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------------------------------------------------------------
# Secrets - NEVER commit real values. Keep them only in .env
# (which must be gitignored).
# ---------------------------------------------------------------
# BAIZE_MODEL_API_KEY=your_api_key_here
